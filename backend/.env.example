PORT=3000
ARK_API_KEY=your_api_key
ARK_MODEL_ID=deepseek-v4-flash-ga-260731
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 文档分块和问题使用同一向量模型，沿用上面的 API Key 和地址。
ARK_EMBEDDING_MODEL_ID=doubao-embedding-vision-251215
# 模型支持 1024 或 2048；修改模型或维度后需重新上传已有文档。
ARK_EMBEDDING_DIMENSIONS=1024

# 单次聊天的总超时时间（毫秒），覆盖连接和流式读取。
ARK_REQUEST_TIMEOUT_MS=120000
ARK_MAX_TOKENS=4000
JSON_BODY_LIMIT=1mb

# 本地开发默认允许跨域；也可以填写逗号分隔的前端地址。
CORS_ORIGIN=*

# 原文件和分块 JSON 的目录，相对 backend/；也可填写绝对路径。
DOCUMENT_STORAGE_DIR=storage/documents
FILE_MAX_BYTES=2097152
# 上传时分块生成向量的总期限；每次模型 HTTP 请求仍使用 ARK_REQUEST_TIMEOUT_MS。
FILE_PROCESSING_TIMEOUT_MS=300000
# 采用 UTF-8 字节数保守估算输入大小，并非精确 token 数。
DOCUMENT_CONTEXT_BUDGET=12000
# 非流式工具决策的循环上限，检索结束后再单独流式回答。
DOCUMENT_MAX_SEARCH_ROUNDS=3
CHAT_INPUT_BUDGET=48000
